<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0"><%= title %></h1>
</div>

<form method="GET" class="row g-2 mb-3">
  <div class="col-auto">
    <select name="status" class="form-select" onchange="this.form.submit()">
      <option value="">Все статусы</option>
      <% STATUSES.forEach(function(s) { %>
        <option value="<%= s %>" <%= selectedStatus === s ? 'selected' : '' %>>
          <%= STATUS_LABELS[s] %>
        </option>
      <% }); %>
    </select>
  </div>
  <% if (selectedStatus) { %>
    <div class="col-auto">
      <a href="/orders" class="btn btn-outline-secondary">Сбросить</a>
    </div>
  <% } %>
</form>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th>#</th>
          <th>Клиент</th>
          <th class="d-none d-md-table-cell">Телефон</th>
          <th>Сумма</th>
          <th>Статус</th>
          <th class="d-none d-lg-table-cell">Дата</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (orders.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">Заказов нет.</td></tr>
        <% } %>
        <% orders.forEach(function(o) { %>
          <tr>
            <td>#<%= o.id %></td>
            <td><%= o.customer_name || '—' %></td>
            <td class="d-none d-md-table-cell"><%= o.customer_phone || '—' %></td>
            <td><%= o.total.toLocaleString('ru-RU') %> ₽</td>
            <td><span class="badge bg-<%= STATUS_BADGES[o.status] %>"><%= STATUS_LABELS[o.status] %></span></td>
            <td class="d-none d-lg-table-cell"><%= o.created_at %></td>
            <td><a href="/orders/<%= o.id %>" class="btn btn-sm btn-outline-primary">Подробнее</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
