<h1 class="mb-4"><%= title %></h1>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card text-bg-secondary h-100">
      <div class="card-body">
        <div class="small">Всего заказов</div>
        <div class="h2 mb-0"><%= stats.total_orders %></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card text-bg-primary h-100">
      <div class="card-body">
        <div class="small">Новых</div>
        <div class="h2 mb-0"><%= stats.new_orders %></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card text-bg-warning h-100">
      <div class="card-body">
        <div class="small">В работе</div>
        <div class="h2 mb-0"><%= stats.in_progress_orders %></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card text-bg-success h-100">
      <div class="card-body">
        <div class="small">Выручка</div>
        <div class="h2 mb-0"><%= stats.total_revenue.toLocaleString('ru-RU') %> ₽</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">Топ-3 товара</div>
      <ul class="list-group list-group-flush">
        <% if (top.length === 0) { %>
          <li class="list-group-item text-muted">Заказов пока нет.</li>
        <% } else { %>
          <% top.forEach(function(p, i) { %>
            <li class="list-group-item d-flex align-items-center">
              <span class="badge bg-secondary me-3"><%= i + 1 %></span>
              <% if (p.image_path) { %>
                <img src="<%= p.image_path %>" alt="" class="thumb me-3">
              <% } else { %>
                <div class="thumb thumb-empty me-3">—</div>
              <% } %>
              <div class="flex-grow-1">
                <div><%= p.name %></div>
                <div class="text-muted small"><%= p.price %> ₽ · продано <%= p.sold %> шт.</div>
              </div>
            </li>
          <% }); %>
        <% } %>
      </ul>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">Последние заказы</div>
      <ul class="list-group list-group-flush">
        <% if (stats.recentOrders.length === 0) { %>
          <li class="list-group-item text-muted">Нет заказов.</li>
        <% } else { %>
          <% stats.recentOrders.forEach(function(o) { %>
            <li class="list-group-item d-flex align-items-center">
              <a href="/orders/<%= o.id %>" class="me-3">#<%= o.id %></a>
              <div class="flex-grow-1">
                <div><%= o.customer_name || '—' %></div>
                <div class="small text-muted"><%= o.created_at %></div>
              </div>
              <span class="badge bg-<%= STATUS_BADGES[o.status] %> me-3"><%= STATUS_LABELS[o.status] %></span>
              <span><%= o.total %> ₽</span>
            </li>
          <% }); %>
        <% } %>
      </ul>
    </div>
  </div>
</div>
