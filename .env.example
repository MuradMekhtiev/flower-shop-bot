# Шаблон переменных окружения. Скопируйте этот файл в .env и заполните значения:
#   Windows:    copy .env.example .env
#   Linux/Mac:  cp .env.example .env
#
# Файл .env в репозиторий НЕ коммитится (см. .gitignore).

# --- Telegram-бот ---
# Получить можно у @BotFather в Telegram: /newbot → следуйте инструкциям.
BOT_TOKEN=paste_token_from_botfather_here

# --- Админка ---
# Логин и пароль администратора веб-панели.
# В пет-проекте сравниваются как plain text — для прода используйте bcrypt-хеш
# (см. TODO в src/admin/routes/auth.js).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# Секрет для подписи cookie-сессий. Должен быть длинным и случайным.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# Порт веб-сервера админки.
PORT=3000
